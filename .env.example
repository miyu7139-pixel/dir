# GEMINI_API_KEY: Google AI Studio 또는 Google Cloud에서 발급받은 Gemini API 키입니다.
# 서버 측(Express / Vercel Serverless / Node.js)에서 process.env.GEMINI_API_KEY 로 사용됩니다.
GEMINI_API_KEY="AIzaSy..."

# VITE_GEMINI_API_KEY: (선택사항) 프론트엔드 단독 정적 호스팅(Vercel SPA 등) 시 클라이언트에서 직접 호출할 경우 사용됩니다.
# Vercel 환경 변수에 VITE_GEMINI_API_KEY 또는 GEMINI_API_KEY를 등록하여 사용할 수 있습니다.
VITE_GEMINI_API_KEY=""

# APP_URL: 앱 호스팅 URL (AI Studio Cloud Run 호스팅 시 자동 주입)
APP_URL="http://localhost:3000"
